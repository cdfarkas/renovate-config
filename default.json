{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "timezone": "Europe/Paris",
  "schedule": ["* 0-6 * * 1"],
  "prConcurrentLimit": 5,
  "prHourlyLimit": 2,
  "labels": ["dependencies"],
  "dependencyDashboard": true,
  "platformAutomerge": true,
  "internalChecksFilter": "strict",
  "packageRules": [
    {
      "description": "Patch/pin/digest: wait 24h after release, then automerge",
      "matchUpdateTypes": ["patch", "pin", "digest"],
      "minimumReleaseAge": "1 day",
      "automerge": true,
      "groupName": "safe updates"
    },
    {
      "description": "Minor: create and automerge",
      "matchUpdateTypes": ["minor"],
      "automerge": true,
      "groupName": "minor updates"
    },
    {
      "description": "Major: dashboard only, PR created only after approval there",
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    },
    {
      "description": "GitHub Actions grouped and automerged",
      "matchManagers": ["github-actions"],
      "automerge": true,
      "groupName": "github-actions"
    },
    {
      "description": "Keep @types bumps with their source package group",
      "matchPackageNames": ["@types/**"],
      "groupName": "type definitions"
    }
  ]
}
