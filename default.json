{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "timezone": "Europe/Paris",
  "schedule": ["* 0-6 * * 1"],
  "prConcurrentLimit": 5,
  "prHourlyLimit": 2,
  "labels": ["dependencies"],
  "dependencyDashboard": true,
  "platformAutomerge": true,
  "packageRules": [
    {
      "description": "Automerge safe updates (checks must pass if any)",
      "matchUpdateTypes": ["patch", "pin", "digest"],
      "groupName": "safe updates",
      "automerge": true
    },
    {
      "description": "GitHub Actions bumped together and automerged",
      "matchManagers": ["github-actions"],
      "groupName": "github-actions",
      "automerge": true
    },
    {
      "description": "Minor updates grouped, merged by hand",
      "matchUpdateTypes": ["minor"],
      "groupName": "minor updates"
    },
    {
      "description": "Keep @types bumps with their source package group",
      "matchPackageNames": ["@types/**"],
      "groupName": "type definitions"
    }
  ]
}
